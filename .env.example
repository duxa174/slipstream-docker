# Slipstream Docker non-interactive configuration
DOMAIN=t2.128938742.xyz
MODE=recursive
RESOLVER=8.8.8.8
NON_INTERACTIVE=true

# Optional overrides
SS_PASSWORD=
SS_METHOD=chacha20-ietf-poly1305
CERT_PATH=/data/config/cert.pem
KEY_PATH=/data/config/key.pem
RESET_SEED_PATH=/data/config/reset-seed
EXPECTED_PUBLIC_IP=
SKIP_DNS_CHECK=false
FORCE_RECONFIGURE=false

# Host port for UDP 53 mapping
HOST_DNS_PORT=53
